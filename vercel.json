{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31556952, immutable"
        }
      ]
    },
    {
      "source": "/:path*.(png|jpg|jpeg|gif|webp|svg|ico|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31556952, immutable"
        }
      ]
    },
    {
      "source": "/:path*.(mp3)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/automatizacion-seguimiento-clientes",
      "destination": "/crm-pymes-seguimiento-clientes/",
      "permanent": true
    },
    {
      "source": "/automatizacion-seguimiento-clientes/",
      "destination": "/crm-pymes-seguimiento-clientes/",
      "permanent": true
    },
    {
      "source": "/automatizacion-procesos-empresas",
      "destination": "/automatizacion-procesos/",
      "permanent": true
    },
    {
      "source": "/automatizacion-procesos-empresas/",
      "destination": "/automatizacion-procesos/",
      "permanent": true
    },
    {
      "source": "/automatizacion-ia-empresas-galicia",
      "destination": "/automatizacion-empresas-galicia/",
      "permanent": true
    },
    {
      "source": "/automatizacion-ia-empresas-galicia/",
      "destination": "/automatizacion-empresas-galicia/",
      "permanent": true
    },
    {
      "source": "/accesibilidad.html",
      "destination": "/accesibilidad/",
      "permanent": true
    },
    {
      "source": "/aviso-legal.html",
      "destination": "/aviso-legal/",
      "permanent": true
    },
    {
      "source": "/cookies.html",
      "destination": "/cookies/",
      "permanent": true
    },
    {
      "source": "/privacidad.html",
      "destination": "/privacidad/",
      "permanent": true
    }
  ]
}
